{
  "name": "schema-forge",
  "main": "worker.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "previews": {},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "schema-forge-db",
      "database_id": "5c20c1c0-fc96-4160-9f7d-263f0eade566",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}